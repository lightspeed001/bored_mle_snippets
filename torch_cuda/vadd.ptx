// src/ptx/vadd.ptx — written by a human. no nvcc was harmed.
.version 8.0                      // conservative on purpose: any modern driver
.target sm_75                     // accepts >= its own arch; see the gotchas
.address_size 64

.visible .entry vadd(
    .param .u64 pa,               // the ABI is positional and untyped-ish:
    .param .u64 pb,               // pointers are .u64, n is .u64, and getting
    .param .u64 pc,               // a width wrong is not a compile error, it is
    .param .u64 pn)               // a CUDA_ERROR_INVALID_PTX at 2am
{
    .reg .pred %p<2>;
    .reg .b32  %r<5>;
    .reg .b64  %rd<9>;
    .reg .f32  %f<3>;

    ld.param.u64  %rd1, [pa];     // param space -> generic
    ld.param.u64  %rd2, [pb];
    ld.param.u64  %rd3, [pc];
    ld.param.u64  %rd4, [pn];
    cvta.to.global.u64 %rd5, %rd1;
    cvta.to.global.u64 %rd6, %rd2;
    cvta.to.global.u64 %rd7, %rd3;

    mov.u32  %r1, %ctaid.x;
    mov.u32  %r2, %ntid.x;
    mov.u32  %r3, %tid.x;
    mad.lo.s32 %r4, %r1, %r2, %r3;    // i
    mul.wide.s32 %rd8, %r4, 4;       // byte offset = i * sizeof(float)

    setp.ge.s64 %p1, %rd8, %rd4;     // if (i >= n) goto DONE;
    @%p1 bra  DONE;

    add.s64  %rd1, %rd5, %rd8;
    ld.global.f32 %f1, [%rd1];       // a[i]
    add.s64  %rd2, %rd6, %rd8;
    ld.global.f32 %f2, [%rd2];       // b[i]
    add.f32  %f3, %f1, %f2;          // the entire payload, again
    add.s64  %rd3, %rd7, %rd8;
    st.global.f32 [%rd3], %f3;       // out[i]

DONE:
    ret;                             // 'ret' in an .entry == kernel exit
}
